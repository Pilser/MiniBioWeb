# ─── Site Identity ───────────────────────────────────────
SITE_NAME=MiniBio Chemical Supply
SITE_SHORT_NAME=MiniBio
SITE_DESCRIPTION=Premium chemical and laboratory supplies for industrial, agricultural, and research applications.
SITE_URL=https://minibioweb.com
SITE_LOGO=/favicon.svg
SITE_FAVICON=/favicon.svg

# ─── Images ──────────────────────────────────────────────
# Banner shown behind avatar. Leave empty for no banner.
# Use relative paths — they resolve to SITE_URL for SEO tags.
SITE_BANNER=/banner.jpg
SITE_AVATAR=/avator.svg

# ─── Contact ─────────────────────────────────────────────
CONTACT_EMAIL=info@pilserlabs.com
CONTACT_PHONE=+256755304241
WHATSAPP_NUMBER=0755304241
WHATSAPP_MESSAGE=Found this product from your site.

# WhatsApp order template. Placeholders: {name} {id} {price} {link}
# Use \n for newlines.
WHATSAPP_ORDER_TEMPLATE="{name}\nlink: {link}"

# ─── Address (clickable on Google Maps) ──────────────────
ADDRESS_TEXT=123 Industrial Blvd, Suite 100, Miami, FL 33101
ADDRESS_URL=https://maps.google.com/?q=123+Industrial+Blvd+Suite+100+Miami+FL+33101

# ─── Categories (comma-separated, "All" first) ───────────
CATEGORIES=All,Chemicals,Laboratory,Industrial,Cleaning,Agriculture,Oils,Reagents

# ─── Social Media ────────────────────────────────────────
# Remove or leave blank any platform you don't use.
SOCIAL_INSTAGRAM=https://instagram.com/minibioweb
SOCIAL_FACEBOOK=https://facebook.com/minibioweb
SOCIAL_TIKTOK=https://tiktok.com/@minibioweb

# ─── Profile Link Buttons ────────────────────────────────
# JSON array. Each: {"label":"...","url":"...","icon":"..."}
# Icons: store, whatsapp, phone, email (Font Awesome class names without "fa-")
# If url is empty (""), it auto-fills from CONTACT_EMAIL / CONTACT_PHONE / WHATSAPP_NUMBER.
LINKS=[{"label":"Browse Our Catalog","url":"#catalog","icon":"store"},{"label":"Contact via WhatsApp","url":"","icon":"whatsapp"},{"label":"Call Us","url":"","icon":"phone"},{"label":"Email Us","url":"","icon":"email"}]

# ─── Google Analytics 4 ───────────────────────────────────
# Measurement ID (starts with G-). Get it from analytics.google.com.
# Leave empty to disable analytics tracking entirely.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── CORS / URL ──────────────────────────────────────────
# All asset paths below are relative (/images/..., /favicon.svg, etc.)
# They resolve to SITE_URL automatically for OG/SEO tags.
# Change SITE_URL to your production domain before deploying.
# SITE_URL=https://yourdomain.com

# ─── Google Search Console ───────────────────────────────
# Verification meta tag content. Get it from Google Search Console.
# Leave empty until you set up GSC.
GSC_VERIFICATION=
