---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<BaseLayout title="Page Not Found | MiniBio" description="The page you're looking for doesn't exist." noindex>
  <Header />

  <main class="not-found container">
    <h1>Page Not Found</h1>
    <p>The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="back-home">Back to Home</a>
  </main>

  <Footer />
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 50vh;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  .not-found h1 {
    font-size: 28px;
    font-weight: 700;
    color: var(--gray-900);
  }

  .not-found p {
    margin-top: 8px;
    font-size: 15px;
    color: var(--gray-500);
  }

  .back-home {
    display: inline-flex;
    align-items: center;
    margin-top: 24px;
    padding: 10px 24px;
    background: var(--gray-900);
    color: white;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s;
  }

  .back-home:hover {
    background: var(--gray-800);
  }
</style>
