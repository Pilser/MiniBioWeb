---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import siteConfig from '../../data/site-config.json'
import products from '../../data/products.json'

export async function getStaticPaths() {
  const allProducts = Array.isArray(products) ? products : []
  return allProducts.map(product => ({
    params: { slug: product.slug },
    props: { product },
  }))
}

const { product } = Astro.props

const hasPrice = product.price != null
const images = product.images && product.images.length > 0 ? product.images : [product.image]
const hasMultipleImages = images.length > 1

const whatsappMsg = siteConfig.whatsappOrderTemplate
  .replace(/{name}/g, product.name)
  .replace(/{id}/g, product.id)
  .replace(/{price}/g, product.price || '')
  .replace(/{link}/g, `${siteConfig.url}/product/${product.slug}/`)

const jsonLd = [
  {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.url,
    logo: `${siteConfig.url}${siteConfig.logo}`,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
      { '@type': 'ListItem', position: 2, name: product.category, item: `${siteConfig.url}/?category=${product.category.toLowerCase()}` },
      { '@type': 'ListItem', position: 3, name: product.name },
    ],
  },
  {
    '@type': 'Product',
    name: product.name,
    description: product.description,
    productID: product.id,
    category: product.category,
    image: images,
    offers: product.price ? {
      '@type': 'Offer',
      price: product.price.replace(/[^0-9.]/g, '') || undefined,
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    } : undefined,
  },
]
---

<BaseLayout
  title={`${product.name} &mdash; ${siteConfig.shortName}`}
  description={product.summary}
  image={product.image}
  product={product}
  jsonLd={jsonLd}
>
  <Header />

  <main class="product-page container">
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href={`/?category=${product.category.toLowerCase()}`}>{product.category}</a></li>
        <li aria-current="page">{product.name}</li>
      </ol>
    </nav>

    <div class="product-layout">
      <div class="product-gallery">
        <div class="modal-image-wrap">
          <img src={images[0]} alt={product.name} id="product-main-image" width="800" height="600" decoding="async" />
        </div>
        {hasMultipleImages && (
          <div class="modal-gallery-nav">
            <button class="gallery-btn gallery-prev" aria-label="Previous image">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <div class="gallery-dots">
              {images.map((_, i) => (
                <span class={"gallery-dot" + (i === 0 ? " active" : "")} data-index={i}></span>
              ))}
            </div>
            <span class="gallery-counter">1 / {images.length}</span>
            <button class="gallery-btn gallery-next" aria-label="Next image">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        )}
      </div>

      <div class="product-info">
        <span class="product-category">{product.category}</span>
        <h1 class="product-name">{product.name}</h1>

        <div class="product-pricing">
          {product.price !== null ? (
            <span class="product-price">{product.price}</span>
          ) : (
            <span class="product-price product-price-request">Request Price</span>
          )}
        </div>

        <p class="product-description">{product.description}</p>

        {(product.specifications && Object.keys(product.specifications).length > 0) || (product.tags && product.tags.length > 0) ? (
          <details class="product-details-toggle">
            <summary>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              Show details
            </summary>
            <div class="product-details-content">
              {product.specifications && Object.keys(product.specifications).length > 0 && (
                <div class="product-specs">
                  <h2>Specifications</h2>
                  <dl>
                    {Object.entries(product.specifications).map(([key, val]) => (
                      <div class="spec-row">
                        <dt>{key}</dt>
                        <dd>{val}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}
              {product.tags && product.tags.length > 0 && (
                <div class="product-tags">
                  {product.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </details>
        ) : null}

        <a
          href={"https://wa.me/" + siteConfig.whatsappNumber + "?text=" + encodeURIComponent(whatsappMsg)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp-full"
          data-track="whatsapp_click"
          data-track-label={product.name}
          data-track-id={product.id}
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Inquire on WhatsApp
        </a>

        <div class="product-cta-section">
          <a href="/" class="btn-browse-all">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            Browse Full Catalog
          </a>
        </div>
      </div>
    </div>

    <div id="image-lightbox" class="lightbox" hidden>
      <div class="lightbox-backdrop"></div>
      <button class="lightbox-close" aria-label="Close fullscreen image">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>
      <button class="lightbox-btn lightbox-prev" aria-label="Previous image">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"></path></svg>
      </button>
      <div class="lightbox-image-wrap">
        <img src="" alt="" id="lightbox-image">
      </div>
      <button class="lightbox-btn lightbox-next" aria-label="Next image">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"></path></svg>
      </button>
      <div class="lightbox-counter"></div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const viewData = JSON.parse(document.getElementById('product-view-data').textContent)
  if (typeof gtag !== 'undefined') {
    gtag('event', 'product_view', {
      product_name: viewData.name,
      product_id: viewData.id,
      product_category: viewData.category,
      product_price: viewData.price || ''
    })
  }

  const images = JSON.parse(document.getElementById('product-data-images').textContent)
  const mainImg = document.getElementById('product-main-image')
  const lightbox = document.getElementById('image-lightbox')
  const lightboxImg = document.getElementById('lightbox-image')
  const lightboxCounter = lightbox.querySelector('.lightbox-counter')
  const lightboxClose = lightbox.querySelector('.lightbox-close')
  const lightboxBackdrop = lightbox.querySelector('.lightbox-backdrop')
  const lightboxPrev = lightbox.querySelector('.lightbox-prev')
  const lightboxNext = lightbox.querySelector('.lightbox-next')
  const prevBtn = document.querySelector('.gallery-prev')
  const nextBtn = document.querySelector('.gallery-next')
  const dots = document.querySelectorAll('.gallery-dot')
  let currentIndex = 0
  let isLightboxOpen = false

  function showImage(index) {
    currentIndex = index
    mainImg.src = images[index]
    dots.forEach((d, i) => d.classList.toggle('active', i === index))
    const counter = document.querySelector('.gallery-counter')
    if (counter) counter.textContent = (index + 1) + ' / ' + images.length
  }

  if (prevBtn && nextBtn) {
    prevBtn.addEventListener('click', function () {
      showImage(currentIndex > 0 ? currentIndex - 1 : images.length - 1)
    })
    nextBtn.addEventListener('click', function () {
      showImage(currentIndex < images.length - 1 ? currentIndex + 1 : 0)
    })
  }

  dots.forEach(function (d) {
    d.addEventListener('click', function () { showImage(Number(d.dataset.index)) })
  })

  function setupSwipe(el, onSwipeLeft, onSwipeRight) {
    var startX = 0, startY = 0, isDown = false

    el.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX
      startY = e.touches[0].clientY
      isDown = true
    }, { passive: true })

    el.addEventListener('touchend', function (e) {
      if (!isDown) return
      isDown = false
      var dx = e.changedTouches[0].clientX - startX
      var dy = e.changedTouches[0].clientY - startY
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
        dx > 0 ? onSwipeRight() : onSwipeLeft()
      }
    }, { passive: true })

    el.addEventListener('mousedown', function (e) {
      startX = e.clientX
      startY = e.clientY
      isDown = true
    })

    document.addEventListener('mousemove', function (e) {
      if (!isDown) return
      e.preventDefault()
    })

    document.addEventListener('mouseup', function (e) {
      if (!isDown) return
      isDown = false
      var dx = e.clientX - startX
      var dy = e.clientY - startY
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
        dx > 0 ? onSwipeRight() : onSwipeLeft()
      }
    })
  }

  mainImg.addEventListener('click', function () { openLightbox(currentIndex) })

  if (images.length > 1) {
    setupSwipe(mainImg,
      function () { showImage(currentIndex < images.length - 1 ? currentIndex + 1 : 0) },
      function () { showImage(currentIndex > 0 ? currentIndex - 1 : images.length - 1) }
    )
  }

  function openLightbox(index) {
    isLightboxOpen = true
    currentIndex = index
    lightboxImg.src = images[index]
    updateLightboxCounter()
    lightbox.hidden = false
    requestAnimationFrame(function () { lightbox.classList.add('open') })
    if (images.length > 1) {
      setupSwipe(lightboxImg, goNext, goPrev)
    }
  }

  function closeLightbox() {
    lightbox.classList.remove('open')
    isLightboxOpen = false
    setTimeout(function () { lightbox.hidden = true }, 300)
  }

  function updateLightboxCounter() {
    if (images.length > 1) {
      lightboxCounter.textContent = (currentIndex + 1) + ' / ' + images.length
    } else {
      lightboxCounter.textContent = ''
    }
  }

  function goPrev() {
    currentIndex = currentIndex > 0 ? currentIndex - 1 : images.length - 1
    lightboxImg.src = images[currentIndex]
    updateLightboxCounter()
  }

  function goNext() {
    currentIndex = currentIndex < images.length - 1 ? currentIndex + 1 : 0
    lightboxImg.src = images[currentIndex]
    updateLightboxCounter()
  }

  if (images.length > 1) {
    lightboxPrev.addEventListener('click', goPrev)
    lightboxNext.addEventListener('click', goNext)
  } else {
    lightboxPrev.style.display = 'none'
    lightboxNext.style.display = 'none'
  }

  lightboxClose.addEventListener('click', closeLightbox)
  lightboxBackdrop.addEventListener('click', closeLightbox)

  document.addEventListener('keydown', function (e) {
    if (!isLightboxOpen) return
    if (e.key === 'Escape') { closeLightbox(); return }
    if (images.length < 2) return
    if (e.key === 'ArrowLeft') goPrev()
    if (e.key === 'ArrowRight') goNext()
  })
</script>

<script type="application/json" id="product-view-data">{JSON.stringify({ name: product.name, id: product.id, category: product.category, price: product.price })}</script>
<script type="application/json" id="product-data-images">{JSON.stringify({ images })}</script>

<style>
  .product-page {
    padding-top: 16px;
    padding-bottom: 32px;
  }

  .breadcrumbs {
    margin-bottom: 14px;
    font-size: 12px;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--gray-500);
  }

  .breadcrumbs li + li::before {
    content: '/';
    color: var(--gray-300);
  }

  .breadcrumbs a {
    color: var(--gray-500);
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--gray-900);
  }

  .breadcrumbs li[aria-current="page"] {
    color: var(--gray-900);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .product-layout {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  .product-gallery {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--gray-50);
  }

  .modal-image-wrap {
    height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    cursor: zoom-in;
  }

  @media (min-width: 768px) {
    .modal-image-wrap {
      height: 400px;
    }
  }

  .modal-image-wrap img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .modal-gallery-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 0 16px 12px;
  }

  .gallery-btn {
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    background: white;
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    color: var(--gray-600);
    transition: background 0.2s;
  }

  .gallery-btn:hover { background: var(--gray-100); }

  .gallery-dots { display: flex; gap: 6px; }

  .gallery-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--gray-300);
    cursor: pointer;
    transition: background 0.2s;
  }

  .gallery-dot.active { background: var(--gray-900); }

  .gallery-counter {
    font-size: 12px;
    font-weight: 500;
    color: var(--gray-400);
    white-space: nowrap;
    min-width: 36px;
    text-align: center;
  }

  .product-category {
    font-size: 12px;
    font-weight: 600;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .product-name {
    font-size: 22px;
    font-weight: 700;
    color: var(--gray-900);
    margin-top: 2px;
    line-height: 1.2;
  }

  .product-pricing {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-top: 6px;
  }

  .product-price {
    font-size: 15px;
    font-weight: 600;
    color: var(--gray-600);
  }

  .product-price-request {
    font-size: 14px;
    font-weight: 500;
    color: var(--gray-500);
  }

  .product-unit {
    font-size: 15px;
    color: var(--gray-400);
  }

  .product-description {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--gray-600);
  }

  .product-details-toggle {
    margin-top: 12px;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .product-details-toggle summary {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 500;
    color: var(--primary);
    cursor: pointer;
    list-style: none;
  }

  .product-details-toggle summary::-webkit-details-marker { display: none; }

  .product-details-toggle[open] summary svg {
    transform: rotate(90deg);
  }

  .product-details-toggle summary svg {
    transition: transform 0.2s;
  }

  .product-details-content {
    padding: 0 12px 12px;
  }

  .product-specs {
    margin-top: 16px;
  }

  .product-specs h2 {
    font-size: 14px;
    font-weight: 600;
    color: var(--gray-900);
    margin-bottom: 8px;
  }

  .product-specs .spec-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--gray-100);
    font-size: 14px;
  }

  .product-specs dt {
    color: var(--gray-500);
    font-weight: 500;
  }

  .product-specs dd {
    color: var(--gray-900);
    font-weight: 500;
    text-align: right;
  }

  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 14px;
  }

  .product-tags .tag {
    padding: 4px 12px;
    background: var(--gray-100);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    color: var(--gray-600);
  }

  .btn-whatsapp-full {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    margin-top: 18px;
    padding: 13px 20px;
    background: var(--whatsapp);
    color: white;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 600;
    transition: background 0.2s;
  }

  .btn-whatsapp-full:hover {
    background: var(--whatsapp-dark);
  }

  .product-cta-section {
    margin-top: 20px;
    text-align: center;
  }

  .btn-browse-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 24px;
    background: var(--primary-bg);
    color: var(--primary);
    border-radius: var(--radius-full);
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s;
  }

  .btn-browse-all:hover {
    background: var(--primary-light);
    color: white;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox[hidden] { display: none; }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.9);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .lightbox.open .lightbox-backdrop { opacity: 1; }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 10;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    color: white;
    cursor: pointer;
    transition: background 0.2s;
  }

  .lightbox-close:hover { background: rgba(255,255,255,0.2); }

  .lightbox-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    color: white;
    cursor: pointer;
    transition: background 0.2s;
  }

  .lightbox-btn:hover { background: rgba(255,255,255,0.2); }

  .lightbox-prev { left: 16px; }

  .lightbox-next { right: 16px; }

  .lightbox-image-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 4px;
  }

  .lightbox-image-wrap img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  @media (min-width: 640px) {
    .lightbox-image-wrap { padding: 24px; }
  }

  .lightbox-counter {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    color: rgba(255,255,255,0.6);
    font-size: 14px;
    font-weight: 500;
  }
</style>
