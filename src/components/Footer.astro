---
import siteConfig from '../data/site-config.json'
---

<footer class="footer">
  <div class="container footer-inner">
    <span>&copy; {new Date().getFullYear()} {siteConfig.shortName}</span>
    <span class="footer-sep" aria-hidden="true">·</span>
    <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
    <span class="footer-sep" aria-hidden="true">·</span>
    <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--gray-900);
    color: var(--gray-400);
    padding: 16px 0;
    margin-top: 48px;
    font-size: 13px;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px;
  }
  .footer a {
    color: var(--gray-400);
    transition: color 0.2s;
  }
  .footer a:hover {
    color: white;
  }
  .footer-sep {
    color: var(--gray-600);
  }
</style>
