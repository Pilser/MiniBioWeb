---
interface Props {}
---

<div id="catalog-app">
  <div id="search-container" class="container"></div>
  <div id="categories-container"></div>
  <div id="product-grid" class="product-grid container">
    <div class="skeleton-grid">
      {Array.from({ length: 8 }).map(() => (
        <div class="skeleton-card">
          <div class="skeleton skeleton-img"></div>
          <div class="skeleton skeleton-line skeleton-line-sm"></div>
          <div class="skeleton skeleton-line"></div>
        </div>
      ))}
    </div>
  </div>

  <div id="scroll-sentinel" class="scroll-sentinel"></div>

  <div id="product-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-label="Product details" hidden>
    <div class="modal-backdrop"></div>
    <div class="modal-panel" role="document">
      <button class="modal-close" aria-label="Close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      <div class="modal-content"></div>
    </div>
  </div>

  <div id="image-lightbox" class="lightbox" hidden>
    <div class="lightbox-backdrop"></div>
    <button class="lightbox-close" aria-label="Close fullscreen image">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
    <button class="lightbox-btn lightbox-prev" aria-label="Previous image">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="lightbox-image-wrap">
      <img src="" alt="" id="lightbox-image" />
    </div>
    <button class="lightbox-btn lightbox-next" aria-label="Next image">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
    </button>
    <div class="lightbox-counter"></div>
  </div>
</div>

<script>
  import FlexSearch from 'flexsearch'

  const products = JSON.parse(document.getElementById('catalog-data')?.textContent || '[]')
  const siteConfig = JSON.parse(document.getElementById('site-config-data')?.textContent || '{}')

  let searchIndex = null

  function buildSearchIndex() {
    const index = new FlexSearch.Index({ tokenize: 'forward' })
    products.forEach((p, i) => {
      const text = [p.name, p.summary, p.description, p.category, ...(p.tags || []), p.id].join(' ')
      index.add(i, text)
    })
    return index
  }

  const PAGE_SIZE = 20
  const GRID = document.getElementById('product-grid')
  const SENTINEL = document.getElementById('scroll-sentinel')
  const MODAL = document.getElementById('product-modal')
  const MODAL_CONTENT = MODAL.querySelector('.modal-content')
  const MODAL_CLOSE = MODAL.querySelector('.modal-close')
  const MODAL_BACKDROP = MODAL.querySelector('.modal-backdrop')
  const LIGHTBOX = document.getElementById('image-lightbox')
  const LIGHTBOX_IMG = document.getElementById('lightbox-image')
  const LIGHTBOX_CLOSE = LIGHTBOX.querySelector('.lightbox-close')
  const LIGHTBOX_PREV = LIGHTBOX.querySelector('.lightbox-prev')
  const LIGHTBOX_NEXT = LIGHTBOX.querySelector('.lightbox-next')
  const LIGHTBOX_COUNTER = LIGHTBOX.querySelector('.lightbox-counter')
  const LIGHTBOX_BACKDROP = LIGHTBOX.querySelector('.lightbox-backdrop')
  const SEARCH_CONTAINER = document.getElementById('search-container')
  const CATEGORIES_CONTAINER = document.getElementById('categories-container')

  let filteredProducts = [...products]
  let renderedCount = 0
  let isLoading = false
  let isEnd = false
  let currentCategory = ''
  let currentSearch = ''
  let isModalOpen = false
  let isLightboxOpen = false
  let lastFocused = null
  let modalImageIndex = 0
  let lightboxImages = []

  function init() {
    searchIndex = buildSearchIndex()
    renderSearchBar()
    renderCategoryNav()
    GRID.innerHTML = ''
    loadMore()
    setupObserver()
    setupModalEvents()
  }

  function renderSearchBar() {
    const wrapper = document.createElement('div')
    wrapper.className = 'search-bar'
    wrapper.innerHTML = `
      <div class="search-wrapper">
        <div class="search-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <input type="search" class="search-input" placeholder="Search products..." aria-label="Search products" autocomplete="off" spellcheck="false" />
      </div>
      <div class="suggestions" id="suggestions" hidden></div>
    `
    const input = wrapper.querySelector('input')
    const suggestions = wrapper.querySelector('#suggestions')

    let debounceTimer, suggestTimer
    input.addEventListener('input', () => {
      const val = input.value.trim()
      clearTimeout(debounceTimer)
      clearTimeout(suggestTimer)
      suggestTimer = setTimeout(() => showSuggestions(val), 80)
      debounceTimer = setTimeout(() => {
        currentSearch = val
        resetAndRender()
        if (typeof gtag !== 'undefined' && val) {
          gtag('event', 'search', { search_term: val })
        }
      }, 200)
    })

    input.addEventListener('focus', () => {
      if (input.value.trim()) showSuggestions(input.value.trim())
    })

    input.addEventListener('blur', () => {
      setTimeout(() => { suggestions.hidden = true }, 200)
    })

    input.addEventListener('keydown', e => {
      if (e.key === 'Escape') suggestions.hidden = true
      const items = suggestions.querySelectorAll('.suggestion-item')
      if (!items.length) return
      const active = suggestions.querySelector('.suggestion-item.active')
      let idx = Array.from(items).indexOf(active)
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        idx = idx < items.length - 1 ? idx + 1 : 0
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        idx = idx > 0 ? idx - 1 : items.length - 1
      } else if (e.key === 'Enter' && active) {
        e.preventDefault()
        active.click()
        return
      } else return
      items.forEach(i => i.classList.remove('active'))
      items[idx].classList.add('active')
    })

    function showSuggestions(query) {
      if (!query) { suggestions.hidden = true; return }
      const ids = searchIndex.search(query, { limit: 6 })
      if (!ids.length) { suggestions.hidden = true; return }
      suggestions.innerHTML = ids.map(i => {
        const p = products[i]
        return `<button type="button" class="suggestion-item" data-index="${i}">
          <img src="${esc(p.image)}" alt="" width="32" height="32" loading="lazy" />
          <div class="suggestion-text">
            <span class="suggestion-name">${esc(p.name)}</span>
            <span class="suggestion-cat">${esc(p.category)}</span>
          </div>
        </button>`
      }).join('')
      suggestions.hidden = false
      suggestions.querySelectorAll('.suggestion-item').forEach(btn => {
        btn.addEventListener('mousedown', e => {
          e.preventDefault()
          const idx = Number(btn.dataset.index)
          currentSearch = products[idx].name
          input.value = currentSearch
          suggestions.hidden = true
          resetAndRender()
        })
      })
    }

    SEARCH_CONTAINER.appendChild(wrapper)
  }

  function renderCategoryNav() {
    const cats = ['All', ...new Set(products.map(p => p.category))]
    const wrapper = document.createElement('div')
    wrapper.className = 'container'
    wrapper.innerHTML = `
      <nav class="categories" aria-label="Product categories">
        <div class="categories-scroll">
          ${cats.map(c => `
            <button class="category-btn" data-category="${c === 'All' ? '' : c}" aria-pressed="${c === 'All'}">${c}</button>
          `).join('')}
        </div>
      </nav>
    `
    wrapper.querySelectorAll('.category-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        wrapper.querySelectorAll('.category-btn').forEach(b => b.setAttribute('aria-pressed', 'false'))
        btn.setAttribute('aria-pressed', 'true')
        currentCategory = btn.getAttribute('data-category') || ''
        resetAndRender()
        if (typeof gtag !== 'undefined') {
          gtag('event', 'category_filter', { category: currentCategory || 'All' })
        }
      })
    })
    CATEGORIES_CONTAINER.appendChild(wrapper)
  }

  function filterProducts() {
    let result = products
    if (currentCategory) {
      result = result.filter(p => p.category === currentCategory)
    }
    if (currentSearch) {
      const q = currentSearch.toLowerCase().trim()
      const ids = searchIndex.search(currentSearch, { limit: 100 })
      const matched = new Set(ids)
      result = result.filter((p, i) => {
        if (matched.has(i)) return true
        const text = [p.name, p.summary, p.description, p.category, ...(p.tags || []), p.id].join(' ').toLowerCase()
        return text.includes(q)
      })
    }
    return result
  }

  function resetAndRender() {
    filteredProducts = filterProducts()
    renderedCount = 0
    isEnd = false
    GRID.innerHTML = ''
    loadMore()
  }

  function loadMore() {
    if (isLoading || isEnd) return
    isLoading = true
    const start = renderedCount
    const end = Math.min(start + PAGE_SIZE, filteredProducts.length)
    const batch = filteredProducts.slice(start, end)
    if (end >= filteredProducts.length) isEnd = true
    const frag = document.createDocumentFragment()
    batch.forEach(p => frag.appendChild(createCard(p)))
    GRID.appendChild(frag)
    renderedCount = end
    isLoading = false
    if (renderedCount === 0) showEmpty()
  }

  function createCard(product) {
    const card = document.createElement('article')
    card.className = 'product-card'
    card.setAttribute('data-product-id', product.id)

    const images = product.images && product.images.length ? product.images : [product.image]

    card.innerHTML = `
      <div class="card-image">
        <img src="${esc(product.image)}" alt="${esc(product.name)}" loading="lazy" decoding="async" />

      </div>
      <div class="card-body">
        <span class="card-category">${esc(product.category)}</span>
        <h3 class="card-title">${esc(product.name)}</h3>
        <div class="card-footer">
          ${product.price != null
            ? `<span class="card-price">${esc(product.price)}</span>`
            : ''
          }
          <a href="${whatsAppUrl(product)}" target="_blank" rel="noopener noreferrer" class="btn-order" onclick="event.stopPropagation()" data-track="whatsapp_click" data-track-label="${esc(product.name)}" data-track-id="${esc(product.id)}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>
    `
    card.addEventListener('click', e => {
      if (e.target.closest('.btn-order')) return
      openModal(product)
    })
    return card
  }

  function showEmpty() {
    GRID.innerHTML = `
      <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <h3>No products found</h3>
        <p>Try adjusting your search or filter</p>
      </div>
    `
  }

  function openModal(product) {
    lastFocused = document.activeElement
    isModalOpen = true
    document.body.style.overflow = 'hidden'
    modalImageIndex = 0

    const images = product.images && product.images.length ? product.images : [product.image]
    const specs = product.specifications
    const hasPrice = product.price != null
    const hasSpecs = specs && Object.keys(specs).length > 0
    const hasTags = product.tags && product.tags.length > 0
    const hasMultipleImages = images.length > 1

    MODAL_CONTENT.innerHTML = `
      <div class="modal-gallery">
        <div class="modal-image-wrap">
          <img src="${esc(images[0])}" alt="${esc(product.name)}" id="modal-main-image" />
        </div>
        ${hasMultipleImages ? `
          <div class="gallery-thumbs">
            ${images.map((img, i) => `
              <button class="gallery-thumb${i === 0 ? ' active' : ''}" data-index="${i}" aria-label="Image ${i + 1}">
                <img src="${esc(img)}" alt="" width="56" height="56" loading="lazy" />
              </button>
            `).join('')}
          </div>
        ` : ''}
      </div>
      <div class="modal-details">
        <span class="modal-category">${esc(product.category)}</span>
        <h2 class="modal-title">${esc(product.name)}</h2>

        ${hasPrice ? `
          <div class="modal-price">
            <span class="modal-price-value">${esc(product.price)}</span>
          </div>
        ` : ''}

        <p class="modal-desc">${esc(product.description)}</p>

        ${hasSpecs || hasTags ? `
          <button class="btn-toggle-details" data-expanded="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            Show details
          </button>
          <div class="modal-extras" hidden>
            ${hasSpecs ? `
              <div class="modal-specs">
                <h3>Specifications</h3>
                <dl>
                  ${Object.entries(specs).map(([k, v]) => `
                    <div class="spec-row"><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>
                  `).join('')}
                </dl>
              </div>
            ` : ''}
            ${hasTags ? `
              <div class="modal-tags">
                ${product.tags.map(t => `<span class="tag">${esc(t)}</span>`).join('')}
              </div>
            ` : ''}
          </div>
        ` : ''}

        <a href="${whatsAppUrl(product)}" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-order" data-track="whatsapp_click" data-track-label="${esc(product.name)}" data-track-id="${esc(product.id)}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Inquire on WhatsApp
        </a>

        <div class="modal-share-row">
          <button class="btn-share" data-track="share_native" data-track-label="${esc(product.name)}" data-share-url="${siteConfig.url}/product/${product.slug}/" data-share-title="${esc(product.name)}" data-share-desc="${esc(product.summary || product.description)}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            Share
          </button>
          <button class="btn-copy-link" data-track="share_copy" data-track-label="${esc(product.name)}" data-copy-url="${siteConfig.url}/product/${product.slug}/">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            Copy Link
          </button>
        </div>
      </div>
    `

    const mainImg = document.getElementById('modal-main-image')

    function showImage(index) {
      modalImageIndex = index
      mainImg.src = images[index]
      if (hasMultipleImages) {
        var thumbs = MODAL_CONTENT.querySelectorAll('.gallery-thumb')
        thumbs.forEach(function (t, i) { t.classList.toggle('active', i === index) })
      }
    }

    if (hasMultipleImages) {
      var thumbs = MODAL_CONTENT.querySelectorAll('.gallery-thumb')
      thumbs.forEach(function (t) {
        t.addEventListener('click', function () { showImage(Number(t.dataset.index)) })
      })
    }

    mainImg.addEventListener('click', () => openLightbox(images, modalImageIndex))

    if (hasMultipleImages) {
      setupSwipe(mainImg,
        function () { showImage(modalImageIndex < images.length - 1 ? modalImageIndex + 1 : 0) },
        function () { showImage(modalImageIndex > 0 ? modalImageIndex - 1 : images.length - 1) }
      )
    }

    const shareNativeBtn = MODAL_CONTENT.querySelector('.btn-share')
    if (shareNativeBtn) {
      shareNativeBtn.addEventListener('click', () => {
        const url = shareNativeBtn.dataset.shareUrl
        const title = shareNativeBtn.dataset.shareTitle
        const desc = shareNativeBtn.dataset.shareDesc
        if (navigator.share) {
          navigator.share({ title, text: desc, url }).catch(() => {})
        } else {
          navigator.clipboard.writeText(url).then(function () {
            var orig = shareNativeBtn.innerHTML
            shareNativeBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Copied!'
            setTimeout(function () { shareNativeBtn.innerHTML = orig }, 2000)
          }).catch(function () {})
        }
      })
    }

    const copyLinkBtn = MODAL_CONTENT.querySelector('.btn-copy-link')
    if (copyLinkBtn) {
      copyLinkBtn.addEventListener('click', function () {
        var url = copyLinkBtn.dataset.copyUrl
        navigator.clipboard.writeText(url).then(function () {
          var orig = copyLinkBtn.innerHTML
          copyLinkBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Copied!'
          setTimeout(function () { copyLinkBtn.innerHTML = orig }, 2000)
        }).catch(function () {})
      })
    }

    const toggleBtn = MODAL_CONTENT.querySelector('.btn-toggle-details')
    if (toggleBtn) {
      toggleBtn.addEventListener('click', function () {
        var expanded = toggleBtn.getAttribute('data-expanded') === 'true'
        var extras = MODAL_CONTENT.querySelector('.modal-extras')
        if (expanded) {
          extras.hidden = true
          toggleBtn.setAttribute('data-expanded', 'false')
          toggleBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg> Show details'
        } else {
          extras.hidden = false
          toggleBtn.setAttribute('data-expanded', 'true')
          toggleBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg> Hide details'
        }
      })
    }

    MODAL.hidden = false
    requestAnimationFrame(() => {
      MODAL.classList.add('open')
      MODAL_CLOSE.focus()
    })
  }

  function closeModal() {
    MODAL.classList.remove('open')
    isModalOpen = false
    document.body.style.overflow = ''
    setTimeout(() => {
      MODAL.hidden = true
      if (lastFocused) lastFocused.focus()
    }, 300)
  }

  function setupModalEvents() {
    MODAL_CLOSE.addEventListener('click', closeModal)
    MODAL_BACKDROP.addEventListener('click', closeModal)
    LIGHTBOX_CLOSE.addEventListener('click', closeLightbox)
    LIGHTBOX_BACKDROP.addEventListener('click', closeLightbox)
    LIGHTBOX_PREV.addEventListener('click', lightboxPrev)
    LIGHTBOX_NEXT.addEventListener('click', lightboxNext)
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        if (isLightboxOpen) closeLightbox()
        else if (isModalOpen) closeModal()
      }
      if (isLightboxOpen) {
        if (e.key === 'ArrowLeft') lightboxPrev()
        if (e.key === 'ArrowRight') lightboxNext()
      }
    })
  }

  function openLightbox(images, index) {
    lightboxImages = images
    modalImageIndex = index
    isLightboxOpen = true
    document.body.style.overflow = 'hidden'
    LIGHTBOX_IMG.src = images[index]
    updateLightboxCounter()
    LIGHTBOX.hidden = false
    requestAnimationFrame(() => {
      LIGHTBOX.classList.add('open')
      LIGHTBOX_CLOSE.focus()
    })
    if (images.length > 1) {
      setupSwipe(LIGHTBOX_IMG, lightboxNext, lightboxPrev)
    }
  }

  function closeLightbox() {
    LIGHTBOX.classList.remove('open')
    isLightboxOpen = false
    document.body.style.overflow = isModalOpen ? 'hidden' : ''
    setTimeout(() => {
      LIGHTBOX.hidden = true
    }, 300)
  }

  function lightboxPrev() {
    const len = lightboxImages.length
    modalImageIndex = modalImageIndex > 0 ? modalImageIndex - 1 : len - 1
    LIGHTBOX_IMG.src = lightboxImages[modalImageIndex]
    updateLightboxCounter()
  }

  function lightboxNext() {
    const len = lightboxImages.length
    modalImageIndex = modalImageIndex < len - 1 ? modalImageIndex + 1 : 0
    LIGHTBOX_IMG.src = lightboxImages[modalImageIndex]
    updateLightboxCounter()
  }

  function updateLightboxCounter() {
    LIGHTBOX_COUNTER.textContent = `${modalImageIndex + 1} / ${lightboxImages.length}`
  }

  function setupObserver() {
    new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting && !isLoading && !isEnd) loadMore() })
    }, { rootMargin: '200px' }).observe(SENTINEL)
  }

  function whatsAppUrl(product) {
    const productUrl = (window.location.origin || siteConfig.url) + '/product/' + product.slug + '/'
    const tpl = siteConfig.whatsappOrderTemplate || '{name}\nlink: {link}'
    const msg = tpl
      .replace(/{name}/g, product.name)
      .replace(/{link}/g, productUrl)
    return `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(msg)}`
  }

  function setupSwipe(el, onSwipeLeft, onSwipeRight) {
    var startX = 0, startY = 0, isDown = false

    el.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX
      startY = e.touches[0].clientY
      isDown = true
    }, { passive: true })

    el.addEventListener('touchend', function (e) {
      if (!isDown) return
      isDown = false
      var dx = e.changedTouches[0].clientX - startX
      var dy = e.changedTouches[0].clientY - startY
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
        dx > 0 ? onSwipeRight() : onSwipeLeft()
      }
    }, { passive: true })

    el.addEventListener('mousedown', function (e) {
      startX = e.clientX
      startY = e.clientY
      isDown = true
    })

    document.addEventListener('mousemove', function (e) {
      if (!isDown) return
      e.preventDefault()
    })

    document.addEventListener('mouseup', function (e) {
      if (!isDown) return
      isDown = false
      var dx = e.clientX - startX
      var dy = e.clientY - startY
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
        dx > 0 ? onSwipeRight() : onSwipeLeft()
      }
    })
  }

  function esc(str) {
    const d = document.createElement('div')
    d.textContent = str
    return d.innerHTML
  }

  document.addEventListener('astro:page-load', init)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init)
  } else {
    init()
  }
</script>

