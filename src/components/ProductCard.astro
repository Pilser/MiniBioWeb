---
import { siteConfig } from '../data/site-config'
import type { Product } from '../data/products'

export interface Props {
  product: Product
}

const { product } = Astro.props
---

<article class="product-card" data-product-id={product.id} role="article">
  <div class="card-image">
    <img
      src={product.image}
      alt={product.name}
      loading="lazy"
      decoding="async"
      width="600"
      height="400"
    />
    {!product.available && (
      <span class="badge badge-unavailable">Unavailable</span>
    )}
    {product.available && (
      <span class="badge badge-available">In Stock</span>
    )}
  </div>

  <div class="card-body">
    <span class="card-category">{product.category}</span>
    <h3 class="card-title">{product.name}</h3>
    <p class="card-summary">{product.summary}</p>

    <div class="card-footer">
      <div class="card-pricing">
        {product.price !== null ? (
          <>
            <span class="card-price">${product.price.toFixed(2)}</span>
            <span class="card-unit">/ {product.unit}</span>
          </>
        ) : (
          <span class="card-price card-price-request">Request Price</span>
        )}
      </div>

      <a
        href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(
          `Hello. I would like to order:\n\nProduct:\n${product.name}\n\nProduct ID:\n${product.id}\n\nQuantity:\n\n---\nPlease provide pricing and delivery details.`
        )}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-order"
        aria-label={`Order ${product.name} on WhatsApp`}
        onclick="event.stopPropagation()"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Order
      </a>
    </div>
  </div>

  <a href={`/product/${product.slug}/`} class="card-link" aria-label={`View details for ${product.name}`} tabindex="-1"></a>
</article>

<style>
  .product-card {
    position: relative;
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--gray-200);
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }

  .product-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .card-image {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--gray-100);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .product-card:hover .card-image img {
    transform: scale(1.03);
  }

  .badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .badge-available {
    background: var(--success-bg);
    color: var(--success);
  }

  .badge-unavailable {
    background: var(--warning-bg);
    color: var(--warning);
  }

  .card-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .card-category {
    font-size: 11px;
    font-weight: 600;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .card-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--gray-900);
    line-height: 1.3;
  }

  .card-summary {
    font-size: 13px;
    color: var(--gray-500);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 10px;
    gap: 8px;
  }

  .card-pricing {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .card-price {
    font-size: 16px;
    font-weight: 700;
    color: var(--gray-900);
  }

  .card-price-request {
    font-size: 13px;
    color: var(--gray-500);
    font-weight: 500;
  }

  .card-unit {
    font-size: 12px;
    color: var(--gray-400);
  }

  .btn-order {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    background: var(--whatsapp);
    color: white;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    transition: background 0.2s;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .btn-order:hover {
    background: var(--whatsapp-dark);
  }

  .card-link {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
</style>
