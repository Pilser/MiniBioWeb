---
import siteConfig from '../data/site-config.json'

const faIcon: Record<string, string> = {
  store: 'fa-store',
  whatsapp: 'fa-whatsapp',
  phone: 'fa-phone',
  email: 'fa-envelope',
}

const socialIcon: Record<string, string> = {
  instagram: 'fa-instagram',
  facebook: 'fa-facebook',
  tiktok: 'fa-tiktok',
  twitter: 'fa-twitter',
  youtube: 'fa-youtube',
  website: 'fa-globe',
}

const socialLabel: Record<string, string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  tiktok: 'TikTok',
  twitter: 'Twitter',
  youtube: 'YouTube',
  website: 'Website',
}
---

<header class={`profile${siteConfig.banner ? ' has-banner' : ''}`}>
  {siteConfig.banner && (
    <div class="profile-banner">
      <img src={siteConfig.banner} alt="" />
    </div>
  )}
  <div class="profile-inner">
    <a href="/" class="profile-avatar-link" aria-label="Home">
      <div class="profile-avatar">
        <img src={siteConfig.avatar} alt={siteConfig.name} width="88" height="88" />
      </div>
    </a>

    <a href="/" class="profile-name-link"><h1 class="profile-name">{siteConfig.name}</h1></a>
    <p class="profile-bio">{siteConfig.description}</p>

    <a href={siteConfig.address.url} target="_blank" rel="noopener noreferrer" class="profile-address">{siteConfig.address.text}</a>

    <div class="profile-social">
      {Object.entries(siteConfig.social).map(([key, url]) => {
        const cls = socialIcon[key]
        if (!cls || !url) return null
        return (
          <a href={url} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={socialLabel[key] || key}>
            <i class={`fab ${cls}`}></i>
          </a>
        )
      })}
    </div>

    <div class="profile-links">
      {siteConfig.links.map(link => {
        const cls = faIcon[link.icon] || 'fa-link'
        const prefix = link.icon === 'whatsapp' ? 'fab' : 'fas'
        let url = link.url
        if (link.icon === 'whatsapp') {
          url = `https://wa.me/${siteConfig.whatsappNumber}?text=Hey%2C%20am%20from%20your%20site`
        } else if (link.icon === 'phone') {
          url = `tel:${siteConfig.contactPhone}`
        } else if (link.icon === 'email') {
          url = `mailto:${siteConfig.contactEmail}`
        }
        return (
          <a href={url} target="_blank" rel="noopener noreferrer" class="link-icon" aria-label={link.label} data-track="header_link_click" data-track-label={link.label}>
            <i class={`${prefix} ${cls}`}></i>
          </a>
        )
      })}
    </div>
  </div>
</header>

<style>
  .profile {
    text-align: center;
  }

  .profile:not(.has-banner) {
    padding-top: 28px;
  }

  .profile-banner {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: var(--gray-100);
  }

  .profile-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .profile-inner {
    max-width: 480px;
    margin: 0 auto;
    padding: 0 16px 16px;
  }

  .profile-avatar-link {
    display: inline-block;
    text-decoration: none;
  }

  .profile-avatar {
    margin-bottom: 12px;
  }

  .has-banner .profile-avatar {
    margin-top: -44px;
  }

  .profile:not(.has-banner) .profile-avatar {
    padding-top: 0;
  }

  .profile-avatar img {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    margin: 0 auto;
    border: 3px solid white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  }

  .profile-name-link {
    display: inline-block;
    text-decoration: none;
    color: inherit;
  }
  .profile-name-link:hover {
    opacity: 0.75;
  }

  .profile-name {
    font-size: 20px;
    font-weight: 700;
    color: var(--gray-900);
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .profile-bio {
    font-size: 13px;
    line-height: 1.5;
    color: var(--gray-500);
    max-width: 340px;
    margin: 0 auto 12px;
  }

  .profile-social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .profile-address {
    display: block;
    font-size: 12px;
    color: var(--gray-500);
    text-decoration: none;
    margin-bottom: 12px;
    transition: color 0.2s;
  }
  .profile-address:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--gray-100);
    color: var(--gray-500);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .social-link i {
    font-size: 18px;
  }

  .social-link:hover {
    background: var(--gray-900);
    color: white;
  }

  .profile-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
  }

  .link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: white;
    border: 1.5px solid var(--gray-200);
    transition: all 0.2s;
  }

  .link-icon:hover {
    background: var(--gray-900);
    border-color: var(--gray-900);
    color: white;
  }

  .link-icon i {
    font-size: 16px;
  }
</style>
