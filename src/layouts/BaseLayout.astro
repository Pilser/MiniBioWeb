---
import SEO from '../components/SEO.astro'
import siteConfig from '../data/site-config.json'
import type { Product } from '../data/products'
import theme from '../data/theme.json'
import '../styles/global.css'

export interface Props {
  title: string
  description: string
  image?: string
  noindex?: boolean
  jsonLd?: object | object[]
  product?: Product
}

const { title, description, image, noindex, jsonLd, product } = Astro.props
const pageTitle = title.includes(siteConfig.shortName) ? title : `${title} | ${siteConfig.shortName}`
const canonical = product
  ? `${siteConfig.url}/product/${product.slug}/`
  : undefined

const t = theme as {
  colors: Record<string, string>
  fonts: Record<string, string>
  radii: Record<string, string>
  shadows: Record<string, string>
  layout: Record<string, string>
}

function cssVar(name: string, value: string): string {
  return `  --${name}: ${value};`
}

function hexToRgb(hex: string): string {
  const r = parseInt(hex.slice(1, 3), 16)
  const g = parseInt(hex.slice(3, 5), 16)
  const b = parseInt(hex.slice(5, 7), 16)
  return `${r}, ${g}, ${b}`
}

const shadowRgb = hexToRgb(t.colors['gray-800'])
const whiteRgb = hexToRgb(t.colors['white'])
const primaryRgb = hexToRgb(t.colors['primary'])

let cssVars = ':root {\n'
for (const [k, v] of Object.entries(t.colors)) cssVars += cssVar(k, v) + '\n'
cssVars += cssVar('font', t.fonts['sans']) + '\n'
cssVars += cssVar('font-mono', t.fonts['mono']) + '\n'
for (const [k, v] of Object.entries(t.radii)) cssVars += cssVar(`radius-${k}`, v) + '\n'
for (const [k, v] of Object.entries(t.shadows)) cssVars += cssVar(`shadow-${k}`, v) + '\n'
for (const [k, v] of Object.entries(t.layout)) cssVars += cssVar(k, v) + '\n'
cssVars += cssVar('shadow-rgb', shadowRgb) + '\n'
cssVars += cssVar('white-rgb', whiteRgb) + '\n'
cssVars += cssVar('primary-rgb', primaryRgb) + '\n'
cssVars += '}\n'
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title={pageTitle}
      description={description}
      canonical={canonical}
      image={product?.image || image}
      type={product ? 'product' : 'website'}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style set:html={cssVars}></style>

    <meta name="theme-color" content={t.colors['gray-900']} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=yes" />
    {siteConfig.gscVerification && (
      <meta name="google-site-verification" content={siteConfig.gscVerification} />
    )}
    {siteConfig.gaMeasurementId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.gaMeasurementId}`}></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${siteConfig.gaMeasurementId}');
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
    {siteConfig.gaMeasurementId && (
      <script is:inline>
        document.addEventListener('click', function(e) {
          var el = e.target.closest('[data-track]');
          if (!el) return;
          var action = el.getAttribute('data-track');
          var label = el.getAttribute('data-track-label') || '';
          var id = el.getAttribute('data-track-id') || '';
          if (typeof gtag !== 'undefined') {
            gtag('event', action, {
              'event_label': label,
              'event_id': id
            });
          }
        });
      </script>
    )}
  </body>
</html>
